{
  "id": "./",
  "name": "SafeIP",
  "short_name": "SafeIP",
  "description": "Verify your network location before accessing sensitive online services.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#2563eb",
  "prefer_related_applications": false,

  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest",
      "id": "./"
    }
  ],

  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "assets/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
